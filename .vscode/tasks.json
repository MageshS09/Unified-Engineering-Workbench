{
  // Run with: Terminal > Run Task..., or press Ctrl+Shift+B (the default build task starts the packaged app).
  // No extension is needed for these tasks; the C/C++ and CMake Tools extensions are optional, for editing only.
  // Optional: set the environment variable WB_TOOLCHAIN_BIN to the bin folder of your MSYS2 UCRT64 toolchain
  // (the folder that contains g++, cmake and ninja) so the build tasks use it; otherwise PATH is used.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Workbench (packaged)",
      "type": "process",
      "command": "${workspaceFolder}/dist/CandidateID_Workbench/Launch.exe",
      "args": [],
      "problemMatcher": [],
      "presentation": { "reveal": "never", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true },
      "detail": "Starts the packaged Launch.exe (build the package first with the 'Package (ZIP)' task)."
    },
    {
      "label": "Configure (CMake Release)",
      "type": "process",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release"],
      "options": { "env": { "PATH": "${env:WB_TOOLCHAIN_BIN};${env:PATH}" } },
      "problemMatcher": []
    },
    {
      "label": "Build (CMake Release)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build"],
      "dependsOn": ["Configure (CMake Release)"],
      "options": { "env": { "PATH": "${env:WB_TOOLCHAIN_BIN};${env:PATH}" } },
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "Run tests",
      "type": "process",
      "command": "ctest",
      "args": ["--test-dir", "build", "--output-on-failure"],
      "dependsOn": ["Build (CMake Release)"],
      "options": { "env": { "PATH": "${env:WB_TOOLCHAIN_BIN};${env:PATH}" } },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Package (ZIP)",
      "type": "process",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "scripts/package.ps1"],
      "problemMatcher": [],
      "detail": "Builds Release, runs the tests, copies everything into dist/ and creates the ZIP."
    }
  ]
}
